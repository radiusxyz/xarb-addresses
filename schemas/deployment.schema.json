{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/radiusxyz/xarb-addresses/schemas/deployment.schema.json",
  "title": "xArb Deployment Address Book",
  "description": "Public deployment metadata for one xArb environment: hub + spokes, contract addresses, chain metadata, and (schema_version 2) the release artifacts offchain components consume. Contains no secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "updated_at",
    "protocol",
    "hub",
    "spokes"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this address-book schema. 1: addresses only. 2: adds protocol.contracts_commit and artifacts.",
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "environment": {
      "description": "Logical environment classification (e.g. testnet, mainnet).",
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "description": "Date this file was last regenerated (YYYY-MM-DD).",
      "type": "string",
      "format": "date"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "release"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "description": "Released contract version, e.g. v0.1.0.",
          "type": "string",
          "minLength": 1
        },
        "contracts_commit": {
          "description": "xarb-infra-contracts commit the addresses and artifacts were produced from (full 40-hex sha). schema_version 2 only.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "hub": {
      "description": "The single hub chain for this environment.",
      "$ref": "#/$defs/chain"
    },
    "spokes": {
      "description": "Spoke chains attached to the hub.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chain"
      }
    },
    "artifacts": {
      "description": "Release artifacts copied byte-for-byte from xarb-infra-contracts config/, with their digests. schema_version 2 only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_registry",
        "hub_abi",
        "spoke_abi",
        "hub_manifest",
        "spoke_manifest"
      ],
      "properties": {
        "event_registry": {
          "$ref": "#/$defs/sha256Artifact"
        },
        "hub_abi": {
          "$ref": "#/$defs/sha256Artifact"
        },
        "spoke_abi": {
          "$ref": "#/$defs/sha256Artifact"
        },
        "hub_manifest": {
          "$ref": "#/$defs/keccakArtifact"
        },
        "spoke_manifest": {
          "$ref": "#/$defs/keccakArtifact"
        }
      }
    }
  },
  "$defs": {
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "name",
        "role",
        "native_symbol",
        "explorer_url",
        "contracts"
      ],
      "properties": {
        "chain_id": {
          "description": "EVM chain ID.",
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "description": "Human-readable chain name, e.g. arbitrum-sepolia.",
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "hub",
            "spoke"
          ]
        },
        "native_symbol": {
          "description": "Native gas token symbol, e.g. ETH, POL.",
          "type": "string",
          "minLength": 1
        },
        "explorer_url": {
          "description": "Base block-explorer URL for the chain.",
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "contracts": {
          "description": "Deployed contracts on this chain, keyed by canonical name (hub, oracle, spoke, lending_pool, ...).",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/contract"
          }
        },
        "substreams": {
          "description": "Optional substreams indexing metadata (spokes).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_block"
          ],
          "properties": {
            "start_block": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "description": "20-byte checksummed or lowercase hex address. May be the zero address for not-yet-deployed entries.",
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      }
    },
    "artifactPath": {
      "description": "Path relative to the environment directory. Must stay under artifacts/.",
      "type": "string",
      "pattern": "^artifacts/[A-Za-z0-9._/-]+$"
    },
    "sha256Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/artifactPath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "keccakArtifact": {
      "description": "Manifests carry keccak256 so the value equals the manifestHash the contracts deployment ledger records.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "keccak256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/artifactPath"
        },
        "keccak256": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "artifacts"
        ],
        "properties": {
          "protocol": {
            "required": [
              "name",
              "release",
              "contracts_commit"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "artifacts": false,
          "protocol": {
            "properties": {
              "contracts_commit": false
            }
          }
        }
      }
    }
  ]
}
